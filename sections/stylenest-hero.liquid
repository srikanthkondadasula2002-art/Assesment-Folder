{{ 'stylenest.css' | asset_url | stylesheet_tag }}

<section class="stylenest-hero" id="hero-{{ section.id }}">
  <div class="stylenest-hero-content">
    {% if section.settings.tag != blank %}
      <span class="stylenest-hero-tag">{{ section.settings.tag }}</span>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h1>{{ section.settings.heading }}</h1>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p>{{ section.settings.subheading }}</p>
    {% endif %}
    <div class="stylenest-hero-btns">
      {% if section.settings.button_1_label != blank %}
        <a href="{{ section.settings.button_1_link | default: '#catalog' }}" class="stylenest-btn-primary">
          {{ section.settings.button_1_label }}
        </a>
      {% endif %}
      {% if section.settings.button_2_label != blank %}
        <a href="{{ section.settings.button_2_link | default: '#catalog' }}" class="stylenest-btn-outline">
          {{ section.settings.button_2_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "StyleNest Hero Banner",
  "tag": "section",
  "class": "section-stylenest-hero",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Badge Tag",
      "default": "🔥 Trending Now"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Elevate Your Style"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover curated collections of premium fashion essentials."
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Primary Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary Button Label",
      "default": "View Collection"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "StyleNest Hero Banner"
    }
  ]
}
{% endschema %}
